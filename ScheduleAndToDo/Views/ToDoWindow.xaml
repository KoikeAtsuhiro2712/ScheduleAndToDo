<Window x:Class="ScheduleAndToDo.Views.ToDoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ScheduleAndToDo.Views.CommonUI"
        xmlns:local="clr-namespace:ScheduleAndToDo.Views"
        xmlns:vm="clr-namespace:ScheduleAndToDo.ViewModels"
        mc:Ignorable="d"
        Title="ToDoWindow" Height="450" Width="800">
    <StackPanel Margin="10">
        <TextBlock Text="ToDoリスト" TextAlignment="Center" FontSize="20"/>
        <StackPanel Margin="0,0,0,10" HorizontalAlignment="Center">
            <TextBox Width="200" FontSize="20" Text="{Binding NewTitle,UpdateSourceTrigger=PropertyChanged}"/>
            <DatePicker x:Name="DatePart" SelectedDate="{Binding NewDate,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"/>
            <controls:AddButton Height="30"
                                Width="90"
                                FontSize="15"
                                Margin="0,20,0,0"
                                Command="{Binding AddItemCommand}"/>
        </StackPanel>
        <TextBlock Text="未完了"
                   Margin="0,10,0,10"
                   FontSize="15"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <controls:Todolist ItemsSource="{Binding ToDoPendingScheduleItem}"
                               DeleteCommand="{Binding DeleteToDoItemCommand}"/>
        </ScrollViewer>
        <TextBlock Text="完了済"
                   Margin="0,10,0,10"
                   FontSize="15"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!--完了済のタスク-->
            <controls:Todolist ItemsSource="{Binding ToDoCompletingScheduleItem}"
                            DeleteCommand="{Binding DeleteToDoItemCommand}"/>
        </ScrollViewer>
     
        <controls:BackButton Height="30"
                            Width="80"
                            Command="{Binding OpenMainCommand}"/>
    </StackPanel>
</Window>
