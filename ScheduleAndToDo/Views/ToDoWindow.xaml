<Window x:Class="ScheduleAndToDo.Views.ToDoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScheduleAndToDo.Views"
        xmlns:vm="clr-namespace:ScheduleAndToDo.ViewModels"
        mc:Ignorable="d"
        Title="ToDoWindow" Height="450" Width="800">
    <StackPanel Margin="10">
        <StackPanel Margin="0,0,0,10" HorizontalAlignment="Center">
            <TextBox Width="200" FontSize="20" Text="{Binding NewTitle,UpdateSourceTrigger=PropertyChanged}"/>
            <DatePicker x:Name="DatePart" SelectedDate="{Binding deadlineDate,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0"/>
                <Button Content="Add" Height="40" Width="200" FontSize="20" Command="{Binding AddItemCommand}" Margin="0,20,0,0" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ListBox ItemsSource="{Binding ToDoItems}" Height="200">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontSize="20" HorizontalAlignment="Center" />
                            <Button Content="削除" Height="30" Width="50" FontSize="20" Margin="5" Command="{Binding DataContext.DeleteToDoItemCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
        
        <Button Content="戻る" Height="40" Width="100" FontSize="20" Margin="5" Command="{Binding OpenMainCommand}"/>
    </StackPanel>
</Window>
