<Window x:Class="ScheduleAndToDo.Views.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScheduleAndToDo.Views"
        mc:Ignorable="d"
        Title="ScheduleWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="今後の予定" FontSize="20"/>

            <ListBox Grid.Row="1"
                 ItemsSource="{Binding SelectedDateScheduleItem}"
                 Margin="5"
                 Height="200">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Date,StringFormat='yyyy/MM/dd'}" FontSize="12" HorizontalAlignment="Right"  VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding Content}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Grid.Row="2">
                <Button Content="スケジュールを追加する" Height="80" Width="200" FontSize="20" Margin="5" Command="{Binding OpenScheduleAddCommand}"/>
            <Button Content="期間ごとに閲覧する" Height="80" Width="200" FontSize="20" Margin="5" Command="{Binding OpenContextMenuCommand}" CommandParameter="{Binding RelativeSource={RelativeSource self}}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="日毎に見る" Width="200" FontSize="20" Command="{Binding OpenDayScheduleCommand}"/>
                        <MenuItem Header="月毎に見る" Width="200" FontSize="20" Command="{Binding OpenMonthScheduleCommand}"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Content="メインページはこちらへ" Height="80" Width="200" FontSize="20" Margin="5" Command="{Binding OpenMainCommand}"/>
            </StackPanel>
    </Grid>
</Window>
