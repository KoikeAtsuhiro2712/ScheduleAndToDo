<Window x:Class="ScheduleAndToDo.Views.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ScheduleAndToDo.Views.CommonUI"
        xmlns:local="clr-namespace:ScheduleAndToDo.Views"
        mc:Ignorable="d"
        Title="ScheduleWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="今後の予定" FontSize="20"/>
        <!--予定テーブルにあるデータのうち、今日より先の日付を表示する-->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding SelectedDateScheduleItem}"
                 Height="200">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Date,StringFormat='yyyy/MM/dd'}" FontSize="12"  VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding Content}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <!--スケジュールを追加するためのフォームに遷移-->
            <controls:AddButton Height="80"
                                Width="200"
                                FontSize="20"
                                Margin="5"
                                Command="{Binding OpenScheduleAddCommand}"/>
            <!--期間毎でスケジュールを閲覧できる。(日毎 or 月毎)-->
            <Button Height="80" 
                Width="200" 
                FontSize="20" 
                Margin="5" 
                Command="{Binding OpenContextMenuCommand}" 
                CommandParameter="{Binding RelativeSource={RelativeSource self}}"
                Style="{StaticResource MaterialDesignOutlinedButton}">
                <Button.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.MergedDictionaries>
                            <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.Orange.xaml" />
                        </ResourceDictionary.MergedDictionaries>
                    </ResourceDictionary>
                </Button.Resources>
                <TextBlock Text="期間毎に閲覧する"/>
                <Button.ContextMenu>
                    <ContextMenu Background="White">
                        <MenuItem Header="日毎に見る" Width="200" FontSize="20" Command="{Binding OpenDayScheduleCommand}" Background="White" Foreground="Orange"/>
                        <MenuItem Header="月毎に見る" Width="200" FontSize="20" Command="{Binding OpenMonthScheduleCommand}" Background="White" Foreground="Orange"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <!--メイン画面に遷移する-->
            <controls:BackButton Height="80" 
                                Width="200"
                                FontSize="20"
                                Command="{Binding OpenMainCommand}"/>
        </StackPanel>
    </Grid>
</Window>
