<Window x:Class="ScheduleAndToDo.Views.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScheduleAndToDo.Views"
        mc:Ignorable="d"
        Title="ScheduleWindow" Height="450" Width="800">
    <Grid>
        <TextBlock Text="{Binding Today}" FontSize="20" HorizontalAlignment="Center"/>

        <Button Content="メインページはこちらへ" Height="80" Width="200" FontSize="20" Margin="5" Command="{Binding OpenMainCommand}"/>
    </Grid>
</Window>
