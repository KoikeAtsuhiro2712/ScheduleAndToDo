<Window x:Class="ScheduleAndToDo.Views.ScheduleAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScheduleAndToDo.Views"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="ScheduleAdd" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--日付-->
        <StackPanel Orientation="Horizontal" Margin="0 10">
            <Label Content="日付" Width="80" VerticalAlignment="Center" />
            <DatePicker SelectedDate="{Binding DateForUI}" Width="200"/>
        </StackPanel>
        <!--開始時刻-->
        <StackPanel Orientation="Horizontal" Margin="0 10" Grid.Row="1">
            <Label Content="開始時刻" Width="80" VerticalAlignment="Center"/>
            <xctk:TimePicker Value="{Binding StartTime}" Width="200"/>
            <Label Content="終了時刻" Width="80" VerticalAlignment="Center" />
            <xctk:TimePicker Value="{Binding EndTime}" Width="200" />
        </StackPanel>
        <!--内容-->
        <StackPanel Margin="0 10" Grid.Row="3">
            <Label Content="内容:"/>
            <TextBox Text="{Binding Content}"
                     Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
        </StackPanel>
        <!--ボタン群-->
        <StackPanel Orientation="Horizontal" Grid.Row="4">
            <Button Content="登録" Width="100" Height="30" Command="{Binding RegisterCommand}"/>
            <Button Content="戻る" Width="100" Height="30" Command="{Binding OpenScheduleCommand}"/>
        </StackPanel>
    </Grid>
</Window>
