<Window x:Class="ScheduleAndToDo.Views.MonthScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScheduleAndToDo.ViewModels"
        xmlns:local="clr-namespace:ScheduleAndToDo.Views"
        mc:Ignorable="d"
        Title="MonthScheduleWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="←" Command="{Binding PreviousMonthCommand}" Width="40" Margin="5,0"
                    Grid.Column="0" />
                <TextBlock Text="{Binding CurrentDate,StringFormat='{}{0:yyyy年MM月}'}" 
                   Grid.Column="1"
                   TextAlignment="Center"
                   FontSize="24" 
                   FontWeight="Bold"
                   Margin="10"/>
                <Button Content="→"
                    Grid.Column="2"
                    Command="{Binding NextMonthCommand}" Width="40" Margin="5,0"/>
            </Grid>
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding GroupedMonthScheduleItem}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="8" Margin="5,0">
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock Text="{Binding date,StringFormat='{}{0:MM/dd}'}"
                                       FontWeight="Bold" FontSize="16" Margin="0,5"/>
                                <ItemsControl ItemsSource="{Binding items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!--<TextBlock Text="{Binding Content}" 
                                                       TextAlignment="Center"/>-->
                                            <StackPanel Orientation="Horizontal" Margin="5,0">
                                                <TextBlock Text="{Binding StartTime}" FontSize="20"/>
                                                <TextBlock Text="～" FontSize="20"/>
                                                <TextBlock Text="{Binding EndTime}" FontSize="20" Margin="5,0" />
                                                <TextBlock Text="{Binding Content}" FontSize="20"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
