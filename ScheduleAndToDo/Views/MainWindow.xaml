<Window x:Class="ScheduleAndToDo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScheduleAndToDo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Schedule And ToDoList App" FontSize="30" HorizontalAlignment="Center"/>
        <Button Height="80" Width="200"
                FontSize="20"
                Margin="5"
                Command="{Binding OpenScheduleCommand}"
                Style="{StaticResource MaterialDesignOutlinedButton}">
            <Button.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.Orange.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Button.Resources>
            <TextBlock Text="スケジュールはこちらへ"/>
        </Button>
        <Button Height="80" Width="200" 
                FontSize="20" 
                Margin="5" 
                Command="{Binding OpenToDoCommand}"
                Style="{StaticResource MaterialDesignOutlinedButton}">
            <Button.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.Orange.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Button.Resources>
            <TextBlock Text="ToDoリストはこちらへ"/>
        </Button>
    </StackPanel>
</Window>
