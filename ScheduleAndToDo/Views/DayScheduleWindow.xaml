<Window x:Class="ScheduleAndToDo.Views.DayScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScheduleAndToDo.ViewModels"
        xmlns:local="clr-namespace:ScheduleAndToDo.ViewModels"
        mc:Ignorable="d"
        Title="DaySchedule" Height="450" Width="800">
    <StackPanel Margin="10">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10" >
            <Button Content="←" Command="{Binding PriviousDayCommand}" Width="40" Margin="5,0"/>
            <TextBlock Text="{Binding CurrentDate,StringFormat={}{0:yyyy/MM/dd(ddd)}}"
                       FontSize="16" VerticalAlignment="Center" Margin="10,0"/>
            <Button Content="→" Command="{Binding NextDayCommand}" Width="40" Margin="5,0"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding SelectedDateScheduleItem}" Height="300" Margin="0,0,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Content}" FontSize="16"/>
                        <TextBlock Text="{Binding StartTime}" FontSize="16" Margin="5,0"/>
                        <TextBlock Text="{Binding EndTime}" FontSize="16" Margin="5,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal">
            <Button Content="戻る" Command="{Binding BackScheduleCommand}" Height="40" Width="80"/>
        </StackPanel>
    </StackPanel>
</Window>
