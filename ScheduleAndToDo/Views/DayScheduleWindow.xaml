<Window x:Class="ScheduleAndToDo.Views.DayScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScheduleAndToDo.ViewModels"
        xmlns:controls="clr-namespace:ScheduleAndToDo.Views.CommonUI"
        xmlns:local="clr-namespace:ScheduleAndToDo.ViewModels"
        mc:Ignorable="d"
        Title="DaySchedule" Height="450" Width="800">
    <StackPanel Margin="10">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10" >
            <!--前の日のスケジュール表示する-->
            <controls:ArrowButton Width="40"
                                Margin="5,0"
                                Command="{Binding PriviousDayCommand}"/>
            <!--現在の日時を表示する-->
            <TextBlock Text="{Binding CurrentDate,StringFormat={}{0:yyyy/MM/dd(ddd)}}"
                    FontSize="16" VerticalAlignment="Center" Margin="10,0"/>
            <!--次の日のスケジュールを表示する-->
            <controls:ArrowButton Width="40"
                                Margin="5,0"
                                Command="{Binding NextDayCommand}"/>
        </StackPanel>
        <!--該当する日付のスケジュールを表示-->
            <ListView ItemsSource="{Binding SelectedDateScheduleItem}" Height="300" Margin="0,0,0,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="スケジュール" Width="300">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Content}"
                                               FontSize="14"
                                               Foreground="black"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="開始時刻" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StartTime}"
                                           FontSize="14"
                                           Foreground="black"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="終了時刻" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding EndTime}"
                                           FontSize="14"
                                           Foreground="black"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <!--スケジュールのメイン画面に遷移する-->
            <StackPanel Orientation="Horizontal">
            <controls:BackButton Height="40"
                                 Width="80"
                                 Command="{Binding BackScheduleCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
